
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');

:root {
  --dark: #073f43;
  --teal: #087f80;
  --mint: #e9f5f1;
  --cream: #faf9f5;
  --text: #273d3d;
  --muted: #718181;
  --white: #ffffff;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--cream);
  color: var(--text);
  line-height: 1.7;
}

a {
  text-decoration: none;
  color: inherit;
}

.header {
  min-height: 82px;
  padding: 15px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 18px #073f430b;
}

.logo {
  color: var(--dark);
  font-size: 23px;
  font-weight: 700;
  letter-spacing: 2px;
}

.logo span {
  color: var(--teal);
}

.logo-icon {
  color: #b99b62;
}

.logo small {
  display: block;
  font-size: 9px;
  letter-spacing: 4px;
  text-align: center;
}

nav {
  display: flex;
  align-items: center;
  gap: 30px;
  font-size: 13px;
  font-weight: 600;
}

nav a:hover {
  color: var(--teal);
}

.nav-button {
  background: var(--dark);
  color: white;
  padding: 12px 22px;
  border-radius: 5px;
}

.nav-button:hover {
  background: var(--teal);
  color: white;
}

.menu-toggle {
  display: none;
  background: none;
  border: none;
  font-size: 26px;
  color: var(--dark);
}

.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 55px;
  padding: 85px 9%;
  background: var(--mint);
  min-height: 570px;
}

.eyebrow, .section-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  color: var(--teal);
}

.hero h1, h2 {
  font-family: 'Playfair Display', serif;
  line-height: 1.2;
}

.hero h1 {
  font-size: clamp(40px, 5vw, 64px);
  margin: 22px 0;
  color: var(--dark);
}

.hero h1 span, h2 span {
  color: var(--teal);
}

.hero-content > p {
  color: var(--muted);
  max-width: 470px;
  margin-bottom: 25px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.btn {
  display: inline-block;
  padding: 13px 23px;
  border: none;
  border-radius: 5px;
  font-family: inherit;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  transition: .25s;
}

.btn:hover {
  transform: translateY(-3px);
}

.primary {
  background: var(--dark);
  color: white;
}

.secondary {
  border: 1px solid var(--dark);
  color: var(--dark);
}

.hero-note {
  margin-top: 35px;
  font-size: 10px;
  letter-spacing: 3px;
  color: var(--teal);
  font-weight: 700;
}

.hero-image {
  position: relative;
}

.hero-image img, .feature-image img {
  width: 100%;
  height: 410px;
  object-fit: cover;
  border-radius: 150px 10px 10px 10px;
}

.floating-card {
  position: absolute;
  bottom: 25px;
  left: -30px;
  background: white;
  padding: 17px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 8px 30px #00000015;
}

.floating-card > span {
  color: #b99b62;
  font-size: 27px;
}

.floating-card strong, .floating-card small {
  display: block;
}

.floating-card strong {
  font-size: 12px;
}

.floating-card small {
  font-size: 10px;
  color: var(--muted);
}

.section {
  padding: 85px 9%;
}

.intro, .services, .contact {
  text-align: center;
}

.section h2 {
  color: var(--dark);
  font-size: clamp(30px, 4vw, 43px);
  margin: 14px 0;
}

.section-description {
  max-width: 590px;
  margin: 0 auto;
  color: var(--muted);
}

.text-link {
  display: inline-block;
  margin-top: 20px;
  color: var(--teal);
  font-weight: 700;
  font-size: 13px;
}

.services {
  background: #f0f6f3;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 45px;
  text-align: left;
}

.service-card {
  background: white;
  padding: 30px;
  border-radius: 8px;
  transition: .3s;
}

.service-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 30px #073f4310;
}

.service-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  background: var(--mint);
  color: var(--teal);
  border-radius: 50%;
  font-size: 23px;
}

.service-card h3 {
  margin: 18px 0 8px;
  color: var(--dark);
  font-size: 17px;
}

.service-card p {
  color: var(--muted);
  font-size: 13px;
}

.feature {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 65px;
}

.feature-image img {
  border-radius: 10px 120px 10px 10px;
}

.feature-content p {
  color: var(--muted);
  margin: 20px 0 25px;
}

.cta {
  background: var(--dark);
  color: white;
  text-align: center;
}

.cta .section-label {
  color: #a8d7c7;
}

.cta h2 {
  color: white;
  margin: 15px 0;
}

.cta p {
  color: #d0e0dc;
  margin-bottom: 25px;
}

.light {
  background: white;
  color: var(--dark);
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  text-align: left;
  gap: 45px;
  margin-top: 45px;
}

.contact-info h3, .contact-form h3 {
  color: var(--dark);
  margin-bottom: 15px;
}

.contact-info p {
  color: var(--muted);
  margin: 20px 0;
  font-size: 14px;
}

.contact-info strong {
  color: var(--dark);
}

.contact-form {
  background: white;
  padding: 30px;
  border-radius: 10px;
  box-shadow: 0 8px 35px #073f430c;
}

.contact-form label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  margin: 13px 0 5px;
}

.contact-form input,
.contact-form select,
.contact-form textarea {
  width: 100%;
  padding: 13px;
  border: 1px solid #dce6e2;
  border-radius: 5px;
  background: #fcfdfc;
  font-family: inherit;
  font-size: 13px;
}

.contact-form input:focus,
.contact-form textarea:focus,
.contact-form select:focus {
  outline: 1px solid var(--teal);
}

.submit-btn {
  width: 100%;
  margin-top: 20px;
}

.contact-form small {
  display: block;
  margin-top: 12px;
  color: var(--muted);
  font-size: 10px;
}

footer {
  background: #052f32;
  color: white;
  text-align: center;
  padding: 35px 15px;
}

.footer-logo {
  color: white;
}

footer p {
  font-size: 12px;
  color: #bdd2ce;
  margin-top: 8px;
}

footer .copyright {
  font-size: 10px;
  margin-top: 20px;
}

.whatsapp-float {
  position: fixed;
  bottom: 22px;
  right: 20px;
  background: #159b65;
  color: white;
  width: 53px;
  height: 53px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 29px;
  box-shadow: 0 5px 20px #0003;
  z-index: 99;
}

@media (max-width: 800px) {
  .header {
    padding: 14px 5%;
  }

  .menu-toggle {
    display: block;
  }

  nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: white;
    padding: 22px;
    flex-direction: column;
    gap: 20px;
    box-shadow: 0 10px 15px #00000010;
  }

  nav.open {
    display: flex;
  }

  .hero {
    grid-template-columns: 1fr;
    padding: 65px 7%;
    gap: 35px;
  }

  .hero-image img {
    height: 300px;
  }

  .floating-card {
    left: 10px;
  }

  .section {
    padding: 65px 7%;
  }

  .service-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .feature {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .contact-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .service-grid {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: 42px;
  }

  .hero-actions .btn {
    width: 100%;
    text-align: center;
  }

  .contact-form {
    padding: 20px;
  }
}
